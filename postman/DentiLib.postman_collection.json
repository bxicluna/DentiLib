		{
			"name": "login Admin",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.environment.set (\"tokenAdmin\", pm.response.json().token)\r",
							"\r",
							"const statusCode = pm.response.code\r",
							"const reponse = pm.response.json()\r",
							"\r",
							"pm.test(\"The response must be JSON\", function () {\r",
							"    pm.response.to.be.json\r",
							"})\r",
							"\r",
							"if (statusCode == 200) {\r",
							"    pm.test((\"Verifier que le body a un message, token et role\"), () => {\r",
							"        pm.expect(reponse).to.have.property(\"message\");\r",
							"        pm.expect(reponse).to.have.property(\"token\");\r",
							"        pm.expect(reponse).to.have.property(\"role\");\r",
							"    })\r",
							"    pm.test((\"Le message indique que l'utilisateur est connecte\"), () => {\r",
							"        pm.expect(reponse.message).to.eql(\"Vous êtes connecté\")\r",
							"    })\r",
							"    pm.test((\"Le role de l'utilisateur est admin\"), () => {\r",
							"        pm.expect(reponse.role).to.eql(\"admin\")\r",
							"    })\r",
							"}\r",
							"\r",
							"if(statusCode == 401){\r",
							"    pm.test((\"Le mot de passe est incorrect\"), () => {\r",
							"        pm.expect(reponse.message).to.eql(\"Mot de passe incorrect\")\r",
							"    })\r",
							"}\r",
							"\r",
							"if (statusCode == 404) {\r",
							"    pm.test((\"L'utilisateur n'existe pas\"), () => {\r",
							"        pm.expect(reponse.message).to.eql(\"L'utilisateur n'existe pas\")\r",
							"    })\r",
							"}\r",
							"\r",
							"if (statusCode == 400) {\r",
							"    pm.test((\"Merci de remplir tous les champs\"), () => {\r",
							"        pm.expect(reponse.message).to.eql(\"Merci de remplir tous les champs\")\r",
							"    })\r",
							"}\r",
							"\r",
							""
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				},
				{
					"listen": "prerequest",
					"script": {
						"exec": [
