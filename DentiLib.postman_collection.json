	"item": [
		{
			"name": "create admin",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"\r",
							"const statusCode = pm.response.code\r",
							"\r",
							"const reponse = pm.response.json()\r",
							"pm.test(\"The response must be JSON\", function () {\r",
							"    pm.response.to.be.json\r",
							"})\r",
							"\r",
							"if (statusCode == 409) {\r",
							"    pm.test((\"Il y a un message d'erreur dans la réponse\"), () => {\r",
							"        pm.expect(reponse.message).to.eql(\"Email déjà utilisé\")\r",
							"    })\r",
							"}\r",
							"\r",
							"if (statusCode == 201) {\r",
							"    pm.test((\"Check if body have properties Message and admin\"), () => {\r",
							"        pm.expect(reponse).to.have.property(\"message\");\r",
							"        pm.expect(reponse).to.have.property(\"admin\");\r",
							"    })\r",
							"    pm.test((\"Le message indique que l'utilisateur est créé\"), () => {\r",
							"        pm.expect(reponse.message).to.eql(\"Utilisateur créé\")\r",
							"    })\r",
							"}\r",
							"\r",
							"if (statusCode == 400) {\r",
							"    if (pm.iterationData.get(\"emailCreation\") == \"\") {\r",
							"        pm.test(\"Tous les champs sont requis\", function () {\r",
							"            pm.expect(reponse.message).to.eql(\"Merci de remplir tous les champs\")\r",
							"        })\r",
							"    }\r",
							"\r",
							"    if (pm.iterationData.get(\"passwordCreation\") == \"\") {\r",
							"        pm.test(\"Tous les champs sont requis\", function () {\r",
							"            pm.expect(reponse.message).to.eql(\"Merci de remplir tous les champs\")\r",
							"        })\r",
							"    } else if (pm.iterationData.get(\"passwordCreation\").length < 6) {\r",
							"        pm.test(\"Le mot de passe doit être au moins de 6 caractères\", function () {\r",
							"            pm.expect(reponse.message).to.eql(\"Le mot de passe doit contenir au moins 6 caractères\")\r",
							"        })\r",
							"    }\r",
							"\r",
							"    \r",
							"\r",
							"}\r",
							"\r",
							"\r",
							"\r",
							""
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				},
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							""
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\r\n    \"firstName\": \"{{firstName}}\",\r\n    \"lastName\": \"{{lastName}}\",\r\n    \"email\": \"{{emailCreation}}\",\r\n    \"password\": \"{{passwordCreation}}\"\r\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{BASE_URL}}/api/user/registerAdmin",
					"host": [
						"{{BASE_URL}}"
					],
					"path": [
						"api",
						"user",
						"registerAdmin"
					]
				}
			},
