		{
			"name": "login Admin",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.environment.set (\"tokenAdmin\", pm.response.json().token)\r",
							"\r",
							"const statusCode = pm.response.code\r",
							"const reponse = pm.response.json()\r",
							"\r",
							"if(statusCode == 401){\r",
							"    pm.test((\"Le mot de passe est incorrect\"), () => {\r",
							"        pm.expect(reponse.message).to.eql(\"Mot de passe incorrect\")\r",
							"    })\r",
							"}\r",
							"\r",
							"if (statusCode == 404) {\r",
							"    pm.test((\"L'utilisateur n'existe pas\"), () => {\r",
							"        pm.expect(reponse.message).to.eql(\"L'utilisateur n'existe pas\")\r",
							"    })\r",
							"}"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				},
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							""
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
